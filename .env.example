# Backend listener configuration
MARS_NAV_HOST=0.0.0.0
MARS_NAV_PORT=8000

# Copy frontend/.env.example to frontend/.env to configure the browser client.

# Comma-separated browser origins allowed by the backend (local dev defaults are built in).
MARS_NAV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
