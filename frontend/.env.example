# Base URL of the MARS NAV backend (no trailing slash). Leave empty to use same-origin.
VITE_API_BASE_URL=http://localhost:8000
# Optional: NASA Trek HiRISE WMTS template (copy from documentation/hirise_source.txt).
# Placeholders {TileMatrix} {TileRow} {TileCol} are supported, as are {z} {y} {x}.
# (defaults to the Jezero HiRISE mosaic in src/config.js)
# VITE_HIRISE_TILE_URL=

# Optional NASA Trek CTX WMTS endpoint for local Jezero exploration. It defaults
# to the documented 6 m Jezero CTX mosaic and is requested only at high zoom.
# VITE_CTX_TILE_URL=
